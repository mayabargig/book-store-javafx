<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx"
      fx:controller="org.hit.ui.MainController"
      xmlns:fx="http://javafx.com/fxml"
      spacing="20"
      alignment="CENTER"
      prefWidth="600"
      prefHeight="450">
    <Label text="📚 Book Store System"
           styleClass="title"/>

    <Button text="Add Book"
            prefWidth="220"
            prefHeight="40"
            onAction="#handleAdd"/>

    <Button text="Search Book"
            prefWidth="220"
            prefHeight="40"
            onAction="#handleSearch"/>

    <Button text="Show All Books"
            prefWidth="220"
            prefHeight="40"
            onAction="#handleShowAll"/>

    <Button text="Delete Book"
            prefWidth="220"
            prefHeight="40"
            onAction="#handleDelete"/>

</VBox>