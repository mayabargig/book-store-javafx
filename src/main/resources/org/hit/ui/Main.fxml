<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.hit.ui.MainController"
      alignment="CENTER"
      spacing="30"
      prefWidth="700"
      prefHeight="520"
      styleClass="main-container">

    <Label text="📚 Book Store Management System"
           styleClass="title"/>

    <Label text="Choose a management area"
           styleClass="subtitle"/>

    <HBox alignment="CENTER"
          spacing="35">

        <VBox alignment="CENTER"
              spacing="18"
              styleClass="menu-card">

            <Label text="📖"
                   styleClass="menu-icon"/>

            <Label text="Book Management"
                   styleClass="section-title"/>

            <Label text="Manage the bookstore catalog"
                   styleClass="card-description"/>

            <Button text="Open Book Management"
                    prefWidth="230"
                    prefHeight="45"
                    onAction="#openBookManagement"/>

        </VBox>

        <VBox alignment="CENTER"
              spacing="18"
              styleClass="menu-card">

            <Label text="👤"
                   styleClass="menu-icon"/>

            <Label text="Customer Management"
                   styleClass="section-title"/>

            <Label text="Manage bookstore customers"
                   styleClass="card-description"/>

            <Button text="Open Customer Management"
                    prefWidth="230"
                    prefHeight="45"
                    onAction="#openCustomerManagement"/>

        </VBox>

    </HBox>

</VBox>