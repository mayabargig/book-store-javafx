<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.hit.ui.UpdateBookController"
      spacing="18"
      alignment="CENTER"
      prefWidth="700"
      prefHeight="520">

    <Label text="✏️ Update Book"
           styleClass="screen-title"/>

    <Label text="Enter the existing book ID and its new name"
           styleClass="subtitle"/>

    <TextField fx:id="txtId"
               promptText="Existing Book ID"/>

    <TextField fx:id="txtName"
               promptText="New Book Name"/>

    <Button text="Update Book"
            prefWidth="220"
            prefHeight="40"
            onAction="#updateBook"/>

    <Label fx:id="resultLabel"
           styleClass="result-label"/>

    <Button text="⬅ Back to Menu"
            styleClass="back-button"
            prefWidth="220"
            prefHeight="40"
            onAction="#backToMenu"/>

</VBox>