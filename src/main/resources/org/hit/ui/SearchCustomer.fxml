<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.hit.ui.SearchCustomerController"
      alignment="CENTER"
      spacing="18"
      prefWidth="700"
      prefHeight="520">

    <Label text="🔍 Search Customer"
           styleClass="screen-title"/>

    <Label text="Enter the customer ID"
           styleClass="subtitle"/>

    <TextField fx:id="txtId"
               promptText="Customer ID"/>

    <Button text="Search Customer"
            prefWidth="220"
            prefHeight="40"
            onAction="#searchCustomer"/>

    <VBox alignment="CENTER"
          spacing="8"
          styleClass="result-card">

        <Label fx:id="idLabel"/>
        <Label fx:id="nameLabel"/>
        <Label fx:id="emailLabel"/>

    </VBox>

    <Label fx:id="resultLabel"
           styleClass="result-label"/>

    <Button text="⬅ Back to Customer Menu"
            prefWidth="240"
            prefHeight="40"
            styleClass="back-button"
            onAction="#backToCustomerMenu"/>

</VBox>